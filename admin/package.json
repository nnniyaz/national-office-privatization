{
  "name": "admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "i18n": "node src/shared/core/i18n.js",
    "start": "npm run i18n && vite --port 3000",
    "build": "echo \"Please use build:dev or build:prod \" && exit 1",
    "build:dev": "dotenv -e .env.development concurrently \"npm run i18n\" \"tsc && vite build\"",
    "build:prod": "dotenv -e .env.production concurrently \"npm run i18n\" \"tsc && vite build\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@redux-devtools/extension": "^3.3.0",
    "antd": "^5.20.3",
    "axios": "^1.7.5",
    "concurrently": "^8.2.2",
    "csv-parse": "^5.5.6",
    "dotenv-cli": "^7.4.2",
    "fs": "^0.0.1-security",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.0.5",
    "react-router-dom": "^6.26.1",
    "react-transition-group": "^4.4.5",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-transition-group": "^4.4.11",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "sass": "^1.77.8",
    "typescript": "^5.2.2",
    "vite": "^5.3.4"
  }
